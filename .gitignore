# Modele LLM locale (prea mari pentru git)
models/
*.gguf

# Fisiere hackathon locale (instructiuni, date de validare)
*.pdf
RSH2026_public_validation_set.zip
validation_set/
pasi.md
later.md
agent.md
raport.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
dist/
build/
venv/
.venv/
*.egg

# Secrets (NFR-01) - never commit real keys
.env
.env.local

# Local history / privacy (NFR-02)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Generated results (produced by the tool, never hand-edited)
results/*
!results/.gitkeep

# Packaging
*.spec

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Scan data (poate contine MAC-uri reale)
# Raw live scans (unmasked MACs) are never committed; "delete my history" erases them.
scans/
*.xml
# Allowed: Validation / Test Set files and our lab scans (MACs masked: python lab/mask_macs.py data/lab;
# tests/test_privacy_fixtures.py fails if a lab scan still has a full MAC).
!data/**/*.xml

# Local demo scan with findings on THIS laptop (for the Auto-fix buttons); never committed, not a test fixture.
demo_local/
